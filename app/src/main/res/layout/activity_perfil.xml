<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Perfil">

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#E8F4F8">

        <!-- Toolbar con botón editar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#4CAF50"
            app:title="Mi Perfil"
            app:titleTextColor="#FFFFFF"
            app:menu="@menu/menu_perfil"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Foto de perfil -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="24dp">



                    <TextView
                        android:id="@+id/tvNombreUsuario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Samuel Salasar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>

                <!-- Edad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edad"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvEdad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="26"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Fecha de nacimiento -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha de nacimiento"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvFechaNacimiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="22/08/1999"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Nombre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre:"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Samuel Salasar."
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Apellido -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apellido:"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvApellido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Martínez Linares"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Teléfono -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teléfono:"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="7877-8888"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Correo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Correo:"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SamuelMartinez@gmail.com"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Ratio Sensible -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ratio Sensible ▼"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvRatio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sensible"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Tipo de diabetes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de diabetes: ▼"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvTipoDiabetes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tipo 1"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Sensibilidad -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensibilidad: ▼"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSensibilidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Muy resistente"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Glucosa objetivo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Glucosa objetivo"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvGlucosaObjetivo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="120 mg/dL"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Factor de sensibilidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Factor de sensibilidad"
                        android:textSize="14sp"
                        android:textColor="#666666"/>

                    <ImageButton
                        android:id="@+id/btnInfoFactor"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        android:background="@android:color/transparent"
                        android:contentDescription="Información"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnCalcularFactor"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="Calcular"
                    android:backgroundTint="#E0E0E0"
                    android:textColor="#333333"
                    android:layout_marginBottom="24dp"/>

            </LinearLayout>

        </ScrollView>

        <!-- Pie de página con correo, teléfono, redes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#4CAF50"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Correo de asistencia"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teléfono"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Redes"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Menú lateral -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#C9EDB6"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|center_horizontal">

        <ImageButton
            android:id="@+id/menuUsuario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Usuario"/>

        <ImageButton
            android:id="@+id/menuInformacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/imformacion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Información"/>

        <ImageButton
            android:id="@+id/menuInstitucion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/institucion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Institución"/>

        <ImageButton
            android:id="@+id/menuCalculadora"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calculadora"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calculadora"/>

        <ImageButton
            android:id="@+id/menuCalendario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calendario"/>

        <ImageButton
            android:id="@+id/menuTelefono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/telefono"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Teléfono"/>

        <ImageButton
            android:id="@+id/menuCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/camara"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Cámara"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>