<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Perfil_editar">

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/fondo2"
            app:title="Mi Perfil"
            app:titleTextColor="@color/letras"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Edad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edad"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etEdad"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="26"
                        android:inputType="number"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Fecha de nacimiento -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fecha_de_nacimiento"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etFechaNacimiento"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="22/08/1999"
                        android:inputType="date"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Nombre -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre:"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Samuel Salasar."
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Apellido -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apellido:"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etApellido"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="Martínez Linares"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Teléfono -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tel_fono"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="7877-8888"
                        android:inputType="phone"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Correo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correo"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="SamuelMartinez@gmail.com"
                        android:inputType="textEmailAddress"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Ratio Sensible (Spinner) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ratio Sensible ▼"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerRatio"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Tipo de diabetes (Spinner) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tipo de diabetes: ▼"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerTipoDiabetes"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Sensibilidad (Spinner) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sensibilidad: ▼"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerSensibilidad"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Glucosa objetivo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Glucosa objetivo"
                        android:textSize="14sp"
                        android:textColor="@color/letras"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etGlucosaObjetivo"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:hint="120 mg/dL"
                        android:inputType="number"
                        android:background="@android:drawable/editbox_background"/>

                </LinearLayout>

                <!-- Factor de sensibilidad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Factor de sensibilidad"
                            android:textSize="14sp"
                            android:textColor="@color/letras"
                            android:textStyle="bold"/>

                        <ImageButton
                            android:id="@+id/btnInfoFactor"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/logo"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/informaci_n"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnCalcularFactor"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/calcular"
                        android:backgroundTint="@color/fondo"
                        android:textColor="@color/black"/>

                </LinearLayout>

                <!-- Botón Guardar -->
                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/guardar_perfil"
                    android:backgroundTint="#4CAF50"
                    android:textColor="@color/white"
                    android:textSize="16sp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Menú lateral -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/fondo2"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|center_horizontal">

        <ImageButton
            android:id="@+id/menuUsuario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="@string/usuario"/>

        <ImageButton
            android:id="@+id/menuInformacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/imformacion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="@string/informaci_n"/>

        <ImageButton
            android:id="@+id/menuInstitucion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/institucion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Institución"/>

        <ImageButton
            android:id="@+id/menuCalculadora"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calculadora"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calculadora"/>

        <ImageButton
            android:id="@+id/menuCalendario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calendario"/>

        <ImageButton
            android:id="@+id/menuTelefono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/telefono"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="@string/tel_fono"/>

        <ImageButton
            android:id="@+id/menuCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/camara"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Cámara"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>