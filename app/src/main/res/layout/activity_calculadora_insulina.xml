<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".Calcular_insulina">


    <!-- ── MENÚ LATERAL FIJO (siempre visible) ── -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo2"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|center_horizontal">

        <ImageButton
            android:id="@+id/menuUsuario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Usuario"/>

        <ImageButton
            android:id="@+id/menuFavoritos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Favoritos"/>

        <ImageButton
            android:id="@+id/menuInstitucion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/institucion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Institución"/>

        <ImageButton
            android:id="@+id/menuCalculadora"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calculadora"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calculadora"/>

        <ImageButton
            android:id="@+id/menuCalendario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calendario"/>

        <ImageButton
            android:id="@+id/menuTelefono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/telefono"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Teléfono"/>

        <ImageButton
            android:id="@+id/menuCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/camara"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Cámara"/>

    </LinearLayout>

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculadora"
            android:textSize="16sp"
            android:textColor="@color/letras"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="@color/fondo2"/>

        <!-- Glucosa objetivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Glucosa objetivo"
                android:textSize="16sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvGlucosaObjetivo"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:text="120 mg/dL"
                android:textSize="14sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:background="@color/white"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Botones de pestañas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnTabInsulina"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Calcular insulina"
                android:textSize="13sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:backgroundTint="@color/botones1"
                app:cornerRadius="20dp"/>

            <Button
                android:id="@+id/btnTabCorreccion"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Corrección"
                android:textSize="13sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:backgroundTint="@color/botones2"
                app:cornerRadius="20dp"/>
        </LinearLayout>

        <!-- Contenido que cambia según pestaña -->
        <!-- Vista Calcular insulina -->
        <LinearLayout
            android:id="@+id/layoutInsulina"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calcular insulina"
                android:textSize="15sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:layout_marginBottom="10dp"/>

            <!-- Total de carbohidratos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total de carbohidratos"
                    android:textSize="14sp"
                    android:textColor="@color/letras"
                    android:textStyle="italic"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/etCarbohidratos"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@color/white"
                    android:inputType="numberDecimal"
                    android:paddingStart="8dp"/>
            </LinearLayout>

            <!-- Ratio -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ratio"
                    android:textSize="14sp"
                    android:textColor="@color/letras"
                    android:textStyle="italic"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvRatioCalc"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:text="Sensible"
                    android:textSize="14sp"
                    android:textColor="@color/letras"
                    android:textStyle="italic"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"/>
            </LinearLayout>

            <!-- Botón Calcular -->
            <Button
                android:id="@+id/btnCalcularInsulina"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:text="Calcular"
                android:textSize="13sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:backgroundTint="@color/botones2"
                android:layout_marginBottom="16dp"
                app:cornerRadius="16dp"/>

            <!-- Resultado insulina -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Insulina (Redondeado segun la jeringa)"
                android:textSize="14sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Redondeado"
                    android:textSize="14sp"
                    android:textColor="@color/letras"
                    android:textStyle="italic"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvRedondeado"
                    android:layout_width="120dp"
                    android:layout_height="36dp"
                    android:background="@color/white"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Icono reloj -->
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/reloj"
                android:scaleType="centerInside"
                android:contentDescription="Historial"
                android:layout_marginTop="8dp"/>

        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/fondo3"
            android:padding="8dp"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Correo de asistencia"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teléfono"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Redes"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:gravity="center"/>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>