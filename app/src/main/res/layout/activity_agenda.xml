<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    tools:context=".agenda">


    <!-- ── MENÚ LATERAL FIJO (siempre visible) ── -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo2"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|center_horizontal">

        <ImageButton
            android:id="@+id/menuUsuario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Usuario"/>

        <ImageButton
            android:id="@+id/menuFavoritos"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Favoritos"/>

        <ImageButton
            android:id="@+id/menuInstitucion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/institucion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Institución"/>

        <ImageButton
            android:id="@+id/menuCalculadora"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calculadora"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calculadora"/>

        <ImageButton
            android:id="@+id/menuCalendario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calendario"/>

        <ImageButton
            android:id="@+id/menuTelefono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/telefono"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Teléfono"/>

        <ImageButton
            android:id="@+id/menuCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/camara"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Cámara"/>

    </LinearLayout>
    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agenda"
            android:textSize="16sp"
            android:textColor="@color/letras"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="@color/fondo2"/>

        <!-- Área central -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título Agenda centrado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agenda"
                android:textSize="24sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <!-- Botón Agregar -->
            <Button
                android:id="@+id/btnAgregar"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:text="Agregar"
                android:textSize="15sp"
                android:textColor="@color/letras"
                android:textStyle="italic"
                android:backgroundTint="@color/fondo2"
                android:layout_marginBottom="16dp"
                app:cornerRadius="20dp"/>

            <!-- Filtros: Día y Orden -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Spinner Día -->
                <Spinner
                    android:id="@+id/spinnerDia"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/white"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:entries="@array/dias_semana"/>

                <!-- Spinner Orden -->
                <Spinner
                    android:id="@+id/spinnerOrden"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@color/white"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:entries="@array/orden_agenda"/>
            </LinearLayout>

            <!-- Lista de registros (vacía por ahora) -->
            <ListView
                android:id="@+id/listViewAgenda"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

        </LinearLayout>

        <!-- Pie de página -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/fondo3"
            android:padding="8dp"
            android:gravity="center">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Correo de asistencia"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teléfono"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Redes"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>


</LinearLayout>