<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".llamadas">

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Llamadas"
            android:textSize="16sp"
            android:textColor="@color/letras"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginStart="56dp"
            android:background="@color/fondo2"/>

        <!-- Área central -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="56dp"
            android:padding="16dp"
            android:gravity="top|end">

            <!-- Icono info arriba derecha -->
            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/imformacion"
                android:background="@android:color/transparent"
                android:scaleType="centerInside"
                android:contentDescription="Información"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"/>

            <!-- Botón grande circular de alerta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnAlerta"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/boton_circular"
                    android:contentDescription="Llamada de emergencia"
                    android:elevation="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/sirena" />

                <!-- Botón Agregar -->
                <Button
                    android:id="@+id/btnAgregar"
                    android:layout_width="140dp"
                    android:layout_height="40dp"
                    android:text="Agregar"
                    android:textSize="15sp"
                    android:textColor="@color/letras"
                    android:textStyle="italic"
                    android:backgroundTint="@color/white"
                    app:cornerRadius="20dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Pie de página -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/fondo3"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginStart="56dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Correo de asistencia"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teléfono"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Redes"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Menú lateral izquierdo -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/fondo2"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|center_horizontal">

        <ImageButton
            android:id="@+id/menuUsuario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Usuario"/>

        <ImageButton
            android:id="@+id/menuInformacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/imformacion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Información"/>

        <ImageButton
            android:id="@+id/menuInstitucion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/institucion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Institución"/>

        <ImageButton
            android:id="@+id/menuCalculadora"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calculadora"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calculadora"/>

        <ImageButton
            android:id="@+id/menuCalendario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calendario"/>

        <ImageButton
            android:id="@+id/menuTelefono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/telefono"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Teléfono"/>

        <ImageButton
            android:id="@+id/menuCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/camara"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Cámara"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>