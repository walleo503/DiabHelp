<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".camara">

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cámara"
            android:textSize="18sp"
            android:textColor="@color/letras"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_marginStart="56dp"
            android:background="@color/fondo2"
            android:gravity="center_vertical"/>

        <!-- Área central -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="56dp"
            android:padding="20dp"
            android:gravity="top|center_horizontal">

            <!-- Marco de la cámara (cuadrado) - SUBIDO -->
            <FrameLayout
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:background="@drawable/marco_camara"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp">

            </FrameLayout>

            <!-- Botón Tomar foto - SUBIDO -->
            <Button
                android:id="@+id/btnTomarFoto"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:text="Tomar foto"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:backgroundTint="@color/white"
                app:cornerRadius="25dp"/>

        </LinearLayout>

        <!-- Pie de página -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/fondo3"
            android:padding="10dp"
            android:gravity="center"
            android:layout_marginStart="56dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Correo de asistencia"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teléfono"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

            <View
                android:layout_width="1dp"
                android:layout_height="16dp"
                android:background="@color/white"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Redes"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:textStyle="italic"
                android:gravity="center"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Menú lateral izquierdo -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/fondo2"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="top|center_horizontal">

        <ImageButton
            android:id="@+id/menuUsuario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/logo"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="@string/usuario"/>

        <ImageButton
            android:id="@+id/menuInformacion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/imformacion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="@string/informaci_n"/>

        <ImageButton
            android:id="@+id/menuInstitucion"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/institucion"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Institución"/>

        <ImageButton
            android:id="@+id/menuCalculadora"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calculadora"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calculadora"/>

        <ImageButton
            android:id="@+id/menuCalendario"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/calendario"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Calendario"/>

        <ImageButton
            android:id="@+id/menuTelefono"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/telefono"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="@string/tel_fono"/>

        <ImageButton
            android:id="@+id/menuCamara"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/camara"
            android:background="@android:color/transparent"
            android:scaleType="centerInside"
            android:contentDescription="Cámara"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>